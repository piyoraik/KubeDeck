          }
        }
      }
    },
    "現在値も Prometheus から取る。metrics-server が入っていないクラスタや、scrape 済みの値と表示を揃えたいときに使う。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
