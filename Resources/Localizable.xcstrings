{
  "sourceLanguage": "ja",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    " の ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " in "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " の "
          }
        }
      }
    },
    "%@ %@ → %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ → %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ → %3$@"
          }
        }
      }
    },
    "%@ %@ の Pod を順に入れ替えます。入れ替わっているあいだ、実行中の処理は中断されます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaces the Pods of %1$@ %2$@ one by one. Work in progress is interrupted while they roll over."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ の Pod を順に入れ替えます。入れ替わっているあいだ、実行中の処理は中断されます。"
          }
        }
      }
    },
    "%@ %@ の更新を再開します。止めているあいだに変えた設定は、まとめて反映されます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumes updates for %1$@ %2$@. Settings changed while it was paused are applied together."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ の更新を再開します。止めているあいだに変えた設定は、まとめて反映されます。"
          }
        }
      }
    },
    "%@ %@ の更新を止めます。設定を変えても Pod は入れ替わらなくなり、止めているあいだは前の状態にも戻せません。一覧の Ready の数は揃ったままなので、止めたことは表に出ません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauses updates for %1$@ %2$@. Pods will no longer roll over when you change settings, and you cannot roll back while it is paused. The Ready counts stay matched, so the pause does not show in the list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ の更新を止めます。設定を変えても Pod は入れ替わらなくなり、止めているあいだは前の状態にも戻せません。一覧の Ready の数は揃ったままなので、止めたことは表に出ません。"
          }
        }
      }
    },
    "%@ %@ を削除します。取り消せません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes %1$@ %2$@. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ を削除します。取り消せません。"
          }
        }
      }
    },
    "%@ %@ を起点にする": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start from %1$@ %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ を起点にする"
          }
        }
      }
    },
    "%@ · %lld Pod": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld Pods"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld Pod"
          }
        }
      }
    },
    "%@ · %lld 件選択中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld selected"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld 件選択中"
          }
        }
      }
    },
    "%@ · %lld 秒ごと": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · every %2$lld s"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld 秒ごと"
          }
        }
      }
    },
    "%@ からの退避を要求しました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested a drain of %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ からの退避を要求しました"
          }
        }
      }
    },
    "%@ から応答がありませんでした。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No response from %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から応答がありませんでした。"
          }
        }
      }
    },
    "%@ から応答がありませんでした。件数や使用量は分かりません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No response from %@. Counts and usage are unknown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から応答がありませんでした。件数や使用量は分かりません。"
          }
        }
      }
    },
    "%@ がありません": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がありません"
          }
        }
      }
    },
    "%@ が出ています": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ present"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が出ています"
          }
        }
      }
    },
    "%@ が管理しています。ここで書き戻しても、次の同期で元に戻ります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Managed by %@. Writing back here will be reverted on the next sync."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が管理しています。ここで書き戻しても、次の同期で元に戻ります。"
          }
        }
      }
    },
    "%@ が終了コード %d で失敗しました。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ failed with exit code %2$d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が終了コード %2$d で失敗しました。"
          }
        }
      }
    },
    "%@ で並べ替える": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort by %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で並べ替える"
          }
        }
      }
    },
    "%@ で並べ替え中。もう一度押すと逆順、3 度目で既定（異常が上）に戻る": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorted by %@. Press again to reverse, a third time to return to the default (problems first)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で並べ替え中。もう一度押すと逆順、3 度目で既定（異常が上）に戻る"
          }
        }
      }
    },
    "%@ には rollout が効きません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "rollout does not apply to %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ には rollout が効きません。"
          }
        }
      }
    },
    "%@ に一致する Pod は%@ にありません。レプリカが 0 か、ラベルが食い違っています。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Pod matching %1$@ in %2$@. Either replicas are 0, or the labels do not line up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ に一致する Pod は%2$@ にありません。レプリカが 0 か、ラベルが食い違っています。"
          }
        }
      }
    },
    "%@ に新しい Pod が置かれなくなります。いま載っている Pod はそのまま動き続けます（退避は drain）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No new Pods will be placed on %@. Pods already running there keep running (use drain to evict them)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に新しい Pod が置かれなくなります。いま載っている Pod はそのまま動き続けます（退避は drain）。"
          }
        }
      }
    },
    "%@ に新しい Pod が置かれるようになります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Pods can be placed on %@ again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に新しい Pod が置かれるようになります。"
          }
        }
      }
    },
    "%@ の Role": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roles in %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の Role"
          }
        }
      }
    },
    "%@ の YAML を書き戻しました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrote back the YAML of %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の YAML を書き戻しました"
          }
        }
      }
    },
    "%@ のレプリカ数を %lld にしました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the replica count of %1$@ to %2$lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ のレプリカ数を %2$lld にしました"
          }
        }
      }
    },
    "%@ のローリング再起動を始めました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Started a rolling restart of %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のローリング再起動を始めました"
          }
        }
      }
    },
    "%@ の削除を要求しました。消えるまで少しかかります": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested deletion of %@. It takes a moment to disappear"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の削除を要求しました。消えるまで少しかかります"
          }
        }
      }
    },
    "%@ の更新を再開しました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumed updates for %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の更新を再開しました"
          }
        }
      }
    },
    "%@ の更新を止めました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused updates for %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の更新を止めました"
          }
        }
      }
    },
    "%@ の行は、いま読み込んでいる範囲にありません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No line from %@ in the range loaded so far."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の行は、いま読み込んでいる範囲にありません。"
          }
        }
      }
    },
    "%@ の資源の割り当てを変えました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changed the resource allocation of %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の資源の割り当てを変えました"
          }
        }
      }
    },
    "%@ はクラスタに見つかりませんでした（`kubectl` がこの種別を解決できていません）。読めたぶんだけ出しています。`kubectl api-resources` に出るかを確かめてください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was not found in the cluster (kubectl cannot resolve this type). Only what could be read is shown. Check whether it appears in `kubectl api-resources`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はクラスタに見つかりませんでした（`kubectl` がこの種別を解決できていません）。読めたぶんだけ出しています。`kubectl api-resources` に出るかを確かめてください。"
          }
        }
      }
    },
    "%@ は読み取り専用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is read-only"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は読み取り専用"
          }
        }
      }
    },
    "%@ は読み取り専用に設定されています。%@は行いませんでした。変更するには設定の「コンテキスト」で解除してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is marked read-only. %2$@ was not performed. To change this, clear the mark in Settings › Contexts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は読み取り専用に設定されています。%2$@は行いませんでした。変更するには設定の「コンテキスト」で解除してください。"
          }
        }
      }
    },
    "%@ は読み取り専用に設定されています。設定の「コンテキスト」で解除できます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is marked read-only. You can clear this in Settings › Contexts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は読み取り専用に設定されています。設定の「コンテキスト」で解除できます。"
          }
        }
      }
    },
